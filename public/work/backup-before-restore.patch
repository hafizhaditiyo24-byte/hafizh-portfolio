+===================================================== */
+
+.tools-marquee {
+  position: relative;
+  z-index: 2;
+  width: min(900px, 100%);
+  margin: 12px auto 0;
+}
+
+
+/* LABEL */
+
+.tools-label {
+  width: 100%;
+
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+
+  padding-bottom: 12px;
+  border-bottom: 1px solid rgba(17, 17, 17, .18);
+  font-size: 9px;
+  line-height: 1;
+  letter-spacing: 0.12em;
+  color: rgba(17, 17, 17, .55);
+}
+
+
+/* CONVEYOR WINDOW */
+
+.tools-window {
+  position: relative;
+
+  width: 100%;
+
+  overflow: hidden;
+
+  padding: 18px 0 21px;
+
+  mask-image: linear-gradient(
+    to right,
+    transparent 0%,
+    black 8%,
+    black 92%,
+    transparent 100%
+  );
+
+  -webkit-mask-image: linear-gradient(
+    to right,
+    transparent 0%,
+    black 8%,
+    black 92%,
+    transparent 100%
+  );
+}
+
+
+/* MOVING TRACK */
+
+.tools-track {
+  display: flex;
+  align-items: center;
+  flex-wrap: nowrap;
+
+  width: max-content;
+  gap: 0;
+  white-space: nowrap;
+
+  animation:
+    software-conveyor
+    20s
+    linear
+    infinite;
+
+  will-change: transform;
+}
+
+.tools-group {
+  display: flex;
+  align-items: center;
+  flex-wrap: nowrap;
+  flex: 0 0 auto;
+  gap: 52px;
+  padding-right: 52px;
+  white-space: nowrap;
+}
+
+
+/* INDIVIDUAL ICON */
+
+.tool {
+  flex: 0 0 auto;
+
+  display: flex;
+  align-items: center;
+}
+
+
+/* ICON */
+
+.tool img {
+  width: 44px;
+  height: 44px;
+
+  display: block;
+
+  object-fit: contain;
+
+  opacity: 0.85;
+
+  transition:
+    opacity 0.3s ease,
+    transform 0.3s ease;
+}
+
+
+/* HIDE SOFTWARE NAME */
+
+.tool span {
+  display: none;
+}
+
+
+/* HOVER */
+
+.tool:hover img {
+  opacity: 1;
+  transform: scale(1.08);
+}
