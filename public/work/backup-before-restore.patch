+
+/* =========================================================
+   NAVBAR SECTION TRANSITION AND PRESS FEEDBACK
+========================================================= */
+
+.section-transition {
+  position: fixed;
+  z-index: 999;
+  inset: 0;
+  pointer-events: none;
+  opacity: 0;
+  visibility: hidden;
+  background: rgba(245, 245, 240, .1);
+  -webkit-backdrop-filter: blur(0);
+  backdrop-filter: blur(0);
+  transition:
+    opacity 240ms ease,
+    -webkit-backdrop-filter 240ms ease,
+    backdrop-filter 240ms ease,
+    visibility 0s linear 240ms;
+}
+
+.section-transition.is-active {
+  opacity: 1;
+  visibility: visible;
+  background: rgba(245, 245, 240, .16);
+  -webkit-backdrop-filter: blur(2px);
+  backdrop-filter: blur(2px);
+  transition-delay: 0s;
+}
+
+.navbar .nav-left a,
+.navbar .nav-right a {
+  position: relative;
+  z-index: 0;
+  -webkit-tap-highlight-color: transparent;
+  transition:
+    transform 180ms cubic-bezier(.2, .75, .25, 1),
+    opacity 180ms ease;
+}
+
+.navbar .nav-left a::before,
+.navbar .nav-right a::before {
+  content: '';
+  position: absolute;
+  z-index: -1;
+  inset: -6px -8px;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, .0);
+  box-shadow: 0 2px 10px rgba(255, 255, 255, 0);
+  transition:
+    background-color 200ms ease,
+    box-shadow 200ms ease;
+  pointer-events: none;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .navbar .nav-left a:hover::before,
+  .navbar .nav-right a:hover::before {
+    background: rgba(255, 255, 255, .2);
+    box-shadow: 0 2px 10px rgba(255, 255, 255, .1);
+  }
+}
+
+.navbar .nav-left a:active,
+.navbar .nav-right a:active {
+  opacity: .72;
+  transform: scale(.97);
+}
+
+.navbar .nav-left a:active::before,
+.navbar .nav-right a:active::before {
+  background: rgba(255, 255, 255, .34);
+}
+
+.navbar .nav-left a:focus-visible,
+.navbar .nav-right a:focus-visible {
+  outline: 1px solid rgba(17, 17, 17, .65);
+  outline-offset: 5px;
+  border-radius: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .section-transition {
+    display: none;
+    transition: none;
+  }
+
+  .navbar .nav-left a,
+  .navbar .nav-right a,
+  .navbar .nav-left a::before,
+  .navbar .nav-right a::before {
+    transition: none;
+  }
+}
+
+
+/* =========================================================
+   STEALTH MODE EASTER EGG
+========================================================= */
+
+.stealth-overlay {
+  position: fixed;
+  z-index: 3000;
+  inset: 0;
+
+  display: grid;
+  place-items: center;
+  padding: 28px;
+
+  color: #f5f5f0;
+  background: rgba(8, 9, 10, .78);
+  -webkit-backdrop-filter: blur(0);
+  backdrop-filter: blur(0);
+
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+
+  transition:
+    opacity 520ms cubic-bezier(.16, 1, .3, 1),
+    -webkit-backdrop-filter 520ms ease-out,
+    backdrop-filter 520ms ease-out,
+    visibility 0s linear 520ms;
+}
+
+.stealth-overlay.is-active {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  -webkit-backdrop-filter: blur(4px);
+  backdrop-filter: blur(4px);
+
+  transition-delay: 0s;
+}
+
+.stealth-content {
+  width: min(100%, 820px);
+  text-align: center;
+
+  opacity: 0;
+  transform: translateY(10px);
+
+  transition:
+    opacity 440ms ease-out,
+    transform 520ms cubic-bezier(.16, 1, .3, 1);
+}
+
+.stealth-overlay.is-active .stealth-content {
+  opacity: 1;
+  transform: translateY(0);
+  transition-delay: 220ms;
+}
+
+.stealth-label,
+.stealth-close {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: 10px;
+  font-weight: 400;
+  letter-spacing: .16em;
+}
+
+.stealth-label {
+  margin: 0 0 24px;
+  color: rgba(245, 245, 240, .48);
+}
+
+.stealth-morse {
+  margin: 0;
+
+  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  font-size: clamp(14px, 2.4vw, 22px);
+  font-weight: 400;
+  line-height: 2;
+  letter-spacing: .08em;
+  color: rgba(245, 245, 240, .88);
+  overflow-wrap: anywhere;
+}
+
+.stealth-close {
+  margin-top: 34px;
+  padding: 10px 12px;
+
+  border: 0;
+  background: transparent;
+  color: rgba(245, 245, 240, .42);
+  cursor: pointer;
+
+  transition: color 180ms ease;
+}
+
+.stealth-close:hover,
+.stealth-close:focus-visible {
+  color: rgba(245, 245, 240, .88);
+}
+
+.stealth-close:focus-visible {
+  outline: 1px solid rgba(245, 245, 240, .45);
+  outline-offset: 4px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .stealth-overlay,
+  .stealth-overlay.is-active,
+  .stealth-content,
+  .stealth-overlay.is-active .stealth-content,
+  .stealth-close {
+    transition: none;
+  }
+
+  .stealth-overlay,
+  .stealth-overlay.is-active {
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+
+  .stealth-content,
+  .stealth-overlay.is-active .stealth-content {
+    transform: none;
+  }
+}
